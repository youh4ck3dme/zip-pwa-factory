# Copy to .env for local dev (never commit .env with real keys).
# Vercel production: set these in Project → Settings → Environment Variables.

# --- Production (cloud Supabase) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Local Docker Supabase (recommended for dev) ---
# 1. npm run db:start
# 2. npm run db:env:local
# 3. npm run dev
#
# Local defaults after `supabase start`:
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_PUBLISHABLE_KEY=<anon key from `supabase status -o env`>
#
# Studio UI: http://127.0.0.1:54323
# Postgres:   postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# Edge functions: npm run db:functions (separate terminal)
# Copy supabase/.env.example → supabase/.env.local and set MISTRAL_API_KEY.
# For CI/smoke without API calls: AI_PROVIDER=mock in supabase/.env.local
