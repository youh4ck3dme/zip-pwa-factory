# Supabase edge function secrets (local only — never commit with real keys)
# If no keys are set and AI_PROVIDER is not set, auto-fallback to mock mode.
MISTRAL_API_KEY=
MISTRAL_API_KEY_BACKUP=
MISTRAL_MODEL=mistral-small-latest
# Optional: set to "mock" to force mock mode, or "mistral" to force live AI.
# If omitted, auto-detects based on whether API keys are present.
# AI_PROVIDER=mock
